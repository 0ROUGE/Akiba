# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://nvbpnnopftdqejronxgq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (VAPID) — real keypair, generated for this project.
# Public key is safe client-side; the private key must be a *Secret* in
# Vercel (and a Supabase Edge Function secret) — never NEXT_PUBLIC_*.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLsdWjEMYbGGIwfeC-3fKjBByca7ITzVpd8SNtKrr75hGBhpJifMuEDY6O-ptlDiqsBOgHF_gsYHh2TCVIYho7w

# Server-only secrets (set in Vercel, never in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=6Uiny5ADc65iNgCgtBYaFfFxaK9CuPmhTsoNJA-DlEw
VAPID_SUBJECT=mailto:you@example.com

# Cloudinary (profile picture uploads) — set CLOUDINARY_API_SECRET as a
# Vercel Secret only. Cloud name + API key are not secret and can stay here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App URL — used to build Daraja callback URLs. Set to your real Vercel
# domain (e.g. https://akiba.vercel.app) once deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2FA secret encryption key (Secret in Vercel). Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Daraja (Safaricom M-Pesa) — all Secrets in Vercel, used by the /api/mpesa/*
# route handlers (server-side only, never sent to the browser).
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
