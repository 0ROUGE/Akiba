{
  "name": "AKIBA — Save with intention",
  "short_name": "AKIBA",
  "description": "Deposit from M-Pesa, split it into savings goals and a weekly allowance, and withdraw back to your phone whenever you need to. AKIBA is a ledger and controls layer on top of real M-Pesa transactions.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone"],
  "orientation": "portrait-primary",
  "launch_handler": { "client_mode": "focus-existing" },
  "edge_side_panel": { "preferred_width": 400 },
  "note_taking": { "new_note_url": "/dashboard/goals?new=1" },
  "protocol_handlers": [
    { "protocol": "web+akiba", "url": "/dashboard?action=%s" }
  ],
  "file_handlers": [
    {
      "action": "/dashboard/account",
      "accept": { "image/png": [".png"], "image/jpeg": [".jpg", ".jpeg"], "image/webp": [".webp"] }
    }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["image/*"] }]
    }
  },
  "lang": "en-KE",
  "dir": "ltr",
  "background_color": "#ffffff",
  "theme_color": "#14328C",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Deposit",
      "short_name": "Deposit",
      "description": "Start an M-Pesa deposit into your AKIBA balance",
      "url": "/dashboard/balance?action=deposit",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Savings goals",
      "short_name": "Goals",
      "description": "View and add savings goals",
      "url": "/dashboard/goals",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Spending",
      "short_name": "Spending",
      "description": "See where your allocated money is going",
      "url": "/dashboard/spending",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
